# Local development configuration (Used when running 'npm run dev')

# Option 1: Local backend (port 8081)
VITE_API_BASE_URL=http://localhost:8081/api/admin

# Option 2: Render backend (uncomment to test live backend locally)
# VITE_API_BASE_URL=https://pathshala-meter-backend.onrender.com/api/admin

# Option 3: In-browser Mock Service Worker (MSW)
VITE_USE_MOCKS=false
